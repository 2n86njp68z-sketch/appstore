{
  "expo": {
    "name": "GENIUS",
    "slug": "portfoy-takip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.portfoytakip.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0C29",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.portfoytakip.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0C29",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-background-task",
      "expo-notifications",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.portfoytakip.app.widgets",
          "groupIdentifier": "group.com.portfoytakip.app",
          "widgets": [
            {
              "name": "PortfolioWidget",
              "displayName": "GENIUS Portföy",
              "description": "Portföy değeri, günlük ve toplam kâr/zarar",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ]
    ],
    "scheme": "portfoytakip"
  }
}
